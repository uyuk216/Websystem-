{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/server.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env.development --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=../../.env.development --import tsx src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env.development --import tsx src/db/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "nodemailer": "^10.1.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
}
