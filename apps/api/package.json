{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/server.ts",
    "./db": "./src/db/client.ts",
    "./apps": "./src/apps/apps.ts",
    "./transfer": "./src/usage/transfer.ts",
    "./mailer": "./src/mail/mailer.ts",
    "./deployments": "./src/apps/deployments.ts",
    "./publish": "./src/ingest/publish.ts",
    "./dynamic": "./src/ingest/dynamic.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env.development --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=../../.env.development --import tsx src/server.ts",
    "db:generate": "drizzle-kit generate",
    "admin:purge": "node --env-file-if-exists=../../.env.development --import tsx src/scripts/purge.ts",
    "admin:purge-login-events": "pnpm admin:purge",
    "admin:approve-recovery": "node --env-file-if-exists=../../.env.development --import tsx src/scripts/approve-recovery.ts",
    "db:migrate": "node --env-file-if-exists=../../.env.development --import tsx src/db/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@node-rs/argon2": "^2.2.2",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks-methods": "^6.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "busboy": "^1.6.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "i18n": "workspace:*",
    "nodemailer": "^10.1.1",
    "platform": "workspace:*",
    "postgres": "^3.4.9",
    "shared": "workspace:*"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11"
  }
}
