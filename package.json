{
  "name": "websystem",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:up": "bash scripts/dev-up.sh",
    "dev:down": "bash scripts/dev-down.sh",
    "doctor": "bash scripts/doctor.sh",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev": "concurrently -k -n api,web,worker,static,admin,upload -c blue,green,magenta,yellow,cyan,white \"pnpm --filter api dev\" \"pnpm --filter web dev\" \"pnpm --filter worker dev\" \"pnpm --filter static dev\" \"pnpm --filter admin dev\" \"pnpm --filter upload dev\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "cli": "workspace:*",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.11",
    "concurrently": "^9.1.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "esbuild": "0.25.12"
    }
  }
}
