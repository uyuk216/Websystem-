# cp .env.pii.development.example .env.pii.development して使う（.env.pii.development はコミットしない）
# 個人情報 DB の接続情報。apps/admin のサーバー側と取り込み口だけが読む。apps/api は読まない（.env.development に混ぜない）。
# 以下は開発専用のダミー値（DEV ONLY）。
PII_OWNER_DATABASE_URL=postgres://pii_owner:pii_owner@127.0.0.1:54321/pii
PII_ADMIN_DATABASE_URL=postgres://pii_admin:pii_admin@127.0.0.1:54321/pii
PII_INGEST_DATABASE_URL=postgres://pii_ingest:pii_ingest@127.0.0.1:54321/pii
