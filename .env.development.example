# cp .env.development.example .env.development して使う（.env.development はコミットしない）
DATABASE_URL=postgres://platform:platform@localhost:54320/platform
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_URL=http://localhost:8025
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- API (apps/api) ---
# 以下の鍵は開発専用のダミー値。本番では絶対に使わない（DEV ONLY）。
# 生成: openssl rand -base64 32
EMAIL_ENC_KEY=ZGV2LW9ubHktZW5jLWtleS0zMi1ieXRlcy1sb25nISE=
EMAIL_HASH_KEY=ZGV2LW9ubHktaGFzaC1rZXktMzItYnl0ZXMtbG9uZyE=
APP_ORIGIN=http://localhost:5173
SMTP_URL=smtp://localhost:1025
ADMIN_EMAIL=admin@example.com
RP_ID=localhost
# Number of trusted reverse proxies in front of the API (0 = connect directly; X-Forwarded-For is ignored).
# Dev: the web dev server (Next /api rewrite) is one hop and adds X-Forwarded-For, so use 1.
TRUSTED_PROXY_HOPS=1
S3_REGION=us-east-1
